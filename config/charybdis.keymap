#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// ===================== Combo Macro =====================

#define ZMK_COMBO(NAME, BIND, KEYPOS, LAYER, TIMEOUT, IDLE) \
    combo_##NAME { \
        timeout-ms = <TIMEOUT>; \
        key-positions = <KEYPOS>; \
        bindings = <BIND>; \
        layers = <LAYER>; \
        require-prior-idle-ms = <IDLE>; \
        slow-release; \
    };

// ===================== 全局行为覆盖 =====================

&lt {
    tapping-term-ms = <220>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&sk {
    release-after-ms = <1200>;
    quick-release;
};

&sl {
    ignore-modifiers;
};

// ===================== Combo 时序参数 =====================

#define COMBO_TERM_FAST 30
#define COMBO_TERM_SLOW 40
#define COMBO_TERM_HORIZ 55
#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50
#define COMBO_IDLE_HORIZ 150

/ {
    // ===================== 行为定义 =====================

    behaviors {
        // --- Mod-Morph 标点 ---

        bs_del: bs_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // --- Timeless Home Row Mods ---
        // 位置号体系（Charybdis 41 键）：
        //   主键区 0-35 与 keyball47 一致；拇指 36 37 | 38 39 40

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                6  7  8  9  10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                38 39 40
            >;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37
            >;
            hold-trigger-on-release;
        };

        hmr_ms: hmr_ms {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mkp>;
            hold-trigger-key-positions = <
                0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37
            >;
            hold-trigger-on-release;
        };

        hml_ms: hml_ms {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mkp>;
            hold-trigger-key-positions = <
                6  7  8  9  10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                38 39 40
            >;
            hold-trigger-on-release;
        };

        // 鼠标层专用的 K 键行为：长按 Shift，短按切换滚轮层
        ks_scroll: ks_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&tog>;
        };
    };

    // ===================== Combos (替代符号层) =====================

    combos {
        compatible = "zmk,combos";

        // --- 左手便捷功能 (Z+X, Z+V, X+C, C+V, X+V) ---
        ZMK_COMBO(undo,  &kp LG(Z), 25 26, 0 5, COMBO_TERM_FAST, COMBO_IDLE_FAST)
        ZMK_COMBO(redo,  &kp LG(LS(Z)), 25 28, 0 5, COMBO_TERM_FAST, COMBO_IDLE_FAST)
        ZMK_COMBO(copy,  &kp LG(C), 26 27, 0 5, COMBO_TERM_FAST, COMBO_IDLE_FAST)
        ZMK_COMBO(paste, &kp LG(V), 27 28, 0 5, COMBO_TERM_FAST, COMBO_IDLE_FAST)
        ZMK_COMBO(cut,   &kp LG(X), 26 28, 0 5, COMBO_TERM_FAST, COMBO_IDLE_FAST)

        // --- 左手横向导航 Combos (Home Row) ---
        ZMK_COMBO(word_left,  &kp LC(LEFT),  13 14, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW) // A+S
        ZMK_COMBO(word_up,    &kp LC(UP),    14 15, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW) // S+D
        ZMK_COMBO(word_down,  &kp LC(DOWN),  13 16, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW) // A+F
        ZMK_COMBO(word_right, &kp LC(RIGHT), 15 16, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW) // D+F

        // --- 垂直上行 combos (顶行+中间行) ---
        ZMK_COMBO(excl,    &kp EXCL,   1 13, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(at,      &kp AT,     2 14, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(hash,    &kp HASH,   3 15, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(dollar,  &kp DLLR,   4 16, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(percent, &kp PRCNT,  5 17, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(caret,   &kp CARET,  6 18, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(amps,    &kp AMPS,   7 19, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(star,    &kp STAR,   8 20, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(lpar,    &kp LPAR,   9 21, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
        ZMK_COMBO(rpar,    &kp RPAR,  10 22, 0 1, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

        // --- 横向 combos (右手中间/底排，五种基本符号 - = [ ] \) ---
        ZMK_COMBO(minus,   &kp MINUS, 19 20, 0 1 2, COMBO_TERM_HORIZ, COMBO_IDLE_HORIZ)
        ZMK_COMBO(lbkt,    &kp LBKT,  20 21, 0 1 2, COMBO_TERM_HORIZ, COMBO_IDLE_HORIZ)
        ZMK_COMBO(rbkt,    &kp RBKT,  21 22, 0 1 2, COMBO_TERM_HORIZ, COMBO_IDLE_HORIZ)
        ZMK_COMBO(equal,   &kp EQUAL, 31 32, 0 1 2, COMBO_TERM_HORIZ, COMBO_IDLE_HORIZ)
        ZMK_COMBO(bslh,    &kp BSLH,  32 33, 0 1 2, COMBO_TERM_HORIZ, COMBO_IDLE_HORIZ)
    };

    // ===================== 键映射 =====================
    // 拇指 5 键顺序（每行末 5 项）：左外 左内 | 右内 右中 右外

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: QWERTY 基础层
        default_layer {
            display-name = "QWE";
            bindings = <
            &kp ESC    &kp Q         &kp W         &kp E        &kp R         &kp T                    &kp Y     &kp U          &kp I        &kp O       &kp P           &bs_del
            &kp TAB    &hml LCTRL A  &hml LALT S   &hml LSHFT D &hml LGUI F   &kp G                    &kp H     &hmr RGUI J    &hmr RSHFT K &hmr RALT L &hmr RCTRL SEMI &kp APOS
            &kp LSHFT  &kp Z         &kp X         &kp C        &kp V         &kp B                    &kp N     &kp M          &kp COMMA    &kp DOT     &kp FSLH        &kp RSHFT
                                                   &lt 1 SPACE  &lt 2 GRAVE            &lt 7 ESCAPE  &lt 5 SPACE &kp ENTER
            >;
        };

        // Layer 1: 数字层 (Numpad)
        number_layer {
            display-name = "NUM";
            bindings = <
&kp N7  &kp N8  &kp N9  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &hml LCTRL N4  &hml LALT N5  &hml LSHFT N6  &trans  &trans      &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&kp N1  &kp N2  &kp N3  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
                                                      &kp N0  &trans   &trans  &trans  &trans
            >;
        };

        // Layer 2: 导航层 (左手 sticky mods + 右手导航)
        nav_layer {
            display-name = "NAV";
            bindings = <
&trans   &trans     &trans     &trans      &trans     &trans                   &trans     &trans    &trans   &trans   &trans     &trans
&kp TAB  &sk LCTRL  &sk LALT   &sk LSHFT   &sk LGUI   &trans                   &kp PG_UP  &kp LEFT  &kp DOWN &kp UP   &kp RIGHT  &trans
&trans   &trans     &trans     &trans      &trans     &trans                   &kp PG_DN  &kp HOME  &trans   &kp END  &trans     &trans
                                           &trans     &trans          &trans   &trans     &trans
            >;
        };

        // Layer 3: 功能键层
        function_layer {
            display-name = "FUN";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none                     &none         &kp C_PREV    &kp C_VOL_UP  &kp C_NEXT    &none         &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none                     &none         &none         &kp C_VOL_DN  &none         &none         &trans
&none   &kp F9  &kp F10  &kp F11  &kp F12  &none                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bootloader
                                           &trans   &trans   &trans   &trans       &trans
            >;
        };

        // Layer 4: 自动鼠标层 (轨迹球触发, home row 全透传)
        auto_mouse_layer {
            display-name = "AUTO_M";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans      &trans       &trans       &trans       &trans  &trans
&trans  &trans  &hml_ms LALT RCLK  &ks_scroll LSHFT 6  &hml_ms LGUI LCLK  &trans                    &mkp LCLK    &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mkp LCLK  &trans  &trans                    &trans      &trans       &trans       &trans       &trans  &trans
                                        &trans  &trans            &trans  &trans  &trans
            >;
        };

        // Layer 5: 手动鼠标层 (Smart-Mouse combo 或 lt 5 触发)
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans   &kp N1          &kp N2          &kp N3         &kp N4         &kp N5                    &kp N6         &kp N7             &kp N8              &kp N9             &kp N0     &trans
&trans   &trans          &hml_ms LALT RCLK  &ks_scroll LSHFT 6  &hml_ms LGUI LCLK  &kp PAGE_UP                    &mkp LCLK    &kp RIGHT      &kp UP_ARROW  &kp DOWN_ARROW  &kp LEFT_ARROW  &trans
&trans   &trans          &trans          &mkp LCLK      &trans         &kp PAGE_DOWN              &trans         &kp LG(RIGHT)      &kp LA(RIGHT)       &kp LA(LEFT)      &kp LG(LEFT)  &trans
                                                        &trans         &mo 3             &trans   &trans          &trans
            >;
        };

        // Layer 6: 滚轮层
        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&tog 6  &tog 6  &tog 6  &tog 6  &tog 6  &tog 6                    &tog 6  &tog 6  &tog 6  &tog 6  &tog 6  &tog 6
&tog 6  &tog 6  &tog 6  &tog 6  &tog 6  &tog 6                    &tog 6  &tog 6  &tog 6  &tog 6  &tog 6  &tog 6
&tog 6  &tog 6  &tog 6  &tog 6  &tog 6  &tog 6                    &tog 6  &tog 6  &tog 6  &tog 6  &tog 6  &tog 6
                                &tog 6  &tog 6            &tog 6  &tog 6  &tog 6
            >;
        };

        // Layer 7: 精准指针层 (Snipe)
        snipe_layer {
            display-name = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                         &trans  &trans             &trans       &trans       &trans  &trans
&trans  &trans  &hml_ms LALT RCLK  &trans  &hml_ms LGUI LCLK  &trans                         &mkp LCLK    &trans       &trans       &trans       &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                         &trans  &trans             &trans       &trans       &trans  &trans
                                        &trans  &trans         &trans  &trans  &trans
            >;
        };
    };
};
